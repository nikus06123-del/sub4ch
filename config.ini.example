; ============================================================
;  Sub4ch Checker v2.0 — настройки
;  Строки с ; — комментарии. Меняйте значения после знака =.
; ============================================================

[github]
; Токен нужен ТОЛЬКО для локального запуска на своём ПК.
; В GitHub Actions он НЕ нужен — там используется встроенный
; GITHUB_TOKEN, выдаваемый автоматически.
; Personal Access Token с правом записи в репозиторий (Contents: Read and write).
; Можно также задать переменную окружения GITHUB_TOKEN — она приоритетнее.
; НИКОМУ не показывайте этот файл после вставки токена.
token = ВСТАВЬТЕ_СЮДА_ВАШ_ТОКЕН
; Репозиторий публикации. Пусто = взять из окружения Actions
; (GITHUB_REPOSITORY) или использовать репозиторий по умолчанию.
repo = nikus06123-del/sub4ch
branch = main
; имена файлов подписки в репозитории
path_base64 = sub.txt
path_plain = sub_plain.txt
; файл статистики (пусто = не публиковать)
path_stats = stats.json

[checker]
; интервал обновления в часах (режим --loop)
interval_hours = 2
; максимум конфигов на один адрес IP:порт (защита от списков с сотнями
; фейк-uuid на одном сервере; 0 — без ограничения)
max_configs_per_endpoint = 20
; ограничить итоговую подписку N лучшими конфигами, отсортированными
; по скорости отклика (0 — публиковать все живые)
max_results = 3000
; отдельная МОБИЛЬНАЯ подписка: топ-N самых быстрых серверов публикуется
; в sub_mobile.txt / sub_mobile_plain.txt (0 = не публиковать).
; Меньше серверов в файле — телефон качает подписку быстрее и не тормозит.
mobile_limit = 200
; максимум конфигов на один запуск: если уникальных конфигов больше,
; проверяется случайная выборка (0 — проверять все; можно перекрыть
; переменной окружения CHECKER_MAX_RUN — так делает GitHub Actions)
max_configs_per_run = 0
; локальная папка для файлов подписки (sub.txt / sub_plain.txt / report.txt)
out_dir = out

[sources]
; Динамический пул источников: программа скачивает этот список
; (обновляется сообществом) и каждый цикл берёт из него случайную
; выборку до dynamic_max адресов. Так пул источников растёт сам.
; Пусто = отключить динамические источники.
dynamic_url = https://raw.githubusercontent.com/mehdirzfx/v2ray-sub/main/README.md
; сколько динамических источников брать за цикл (0 = брать все найденные)
dynamic_max = 60

[testing]
; сколько TCP-подключений держать одновременно (ступень 1)
; на слабом ПК/роутере уменьшите до 300-500
tcp_concurrency = 1000
; таймаут TCP-подключения, сек
tcp_timeout = 4
; сколько серверов проверять одновременно через ядро (ступень 2)
; каждый тест — отдельный процесс ядра, ~15-30 МБ ОЗУ на поток
core_concurrency = 100
; таймаут теста через ядро, сек
core_timeout = 10
; URL проверки выхода через сервер (ожидаем ответ 204)
test_urls = http://cp.cloudflare.com/generate_204,http://www.gstatic.com/generate_204
; прокси для доступа к GitHub, если он заблокирован вашим провайдером.
; Пример: socks5://127.0.0.1:2080 (локальный порт Throne) или http://127.0.0.1:2081
; Пусто = ходить напрямую.
http_proxy =

[protocols]
; какие протоколы включать в подписку
; варианты: vless, vmess, trojan, ss, hysteria2, tuic
include = vless,vmess,trojan,ss,hysteria2,tuic
